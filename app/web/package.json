{
  "name": "grc-lake-console",
  "private": true,
  "version": "0.3.14",
  "description": "GRC Lake Console — open-source, headless-first trust operations served by the grc-lake Python package.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack -p 5173",
    "build": "next build --webpack && node scripts/copy_static_export.mjs",
    "build:demo": "export NEXT_PUBLIC_DEMO_SNAPSHOT=1 CONSOLE_BASE_PATH=\"${CONSOLE_BASE_PATH:-/grc-lake/console}\" && next build --webpack && node scripts/assemble_demo_site.mjs",
    "record:demo": "node scripts/record_demo_snapshot.mjs",
    "serve:demo": "node scripts/serve_demo_site.mjs",
    "test:demo": "node --test scripts/test_demo_snapshot.mjs",
    "test:demo-site": "playwright test -c playwright.demo.config.ts",
    "start": "next start -p 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "demo-screenshots": "node scripts/capture_demo_screenshots.mjs",
    "test:e2e": "playwright test",
    "test:dependencies": "node --test scripts/test_braces_security.mjs scripts/test_sidebar_state.mjs",
    "test:sidebar": "node --test scripts/test_sidebar_state.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "^12.12.0",
    "caniuse-lite": "^1.0.30001819",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3"
  }
}
