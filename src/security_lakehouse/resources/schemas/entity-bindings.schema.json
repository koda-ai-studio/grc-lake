{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform_tenant_id", "entities"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "platform_tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entities": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "entity_type", "bindings"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "entity_type": {
            "enum": [
              "person",
              "account",
              "device",
              "resource",
              "repository",
              "service",
              "organization",
              "unknown"
            ]
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "source_account_id",
                "asset_type",
                "asset_id",
                "evidence_sha256",
                "asserted_by",
                "asserted_at",
                "reason"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_account_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "asset_type": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "asserted_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "asserted_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  },
  "title": "entity-bindings"
}
