{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity binding revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform_tenant_id",
    "revision",
    "request_id",
    "request_sha256",
    "actor",
    "reason",
    "recorded_at",
    "bindings",
    "evidence",
    "generation",
    "changes",
    "prev_hash",
    "record_hash",
    "identity_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "platform_tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "bindings": {
      "$ref": "entity-bindings.schema.json"
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "source",
          "source_account_id",
          "asset_type",
          "asset_id",
          "event_id",
          "event_time",
          "raw_sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_account_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "asset_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_id", "manifest_sha256"],
          "properties": {
            "generation_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "removed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "changed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "prev_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity_version": {
      "const": "entity-identity-v1"
    }
  }
}
