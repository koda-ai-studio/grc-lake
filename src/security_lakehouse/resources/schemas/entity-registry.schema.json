{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_version",
    "platform_tenant_id",
    "source_entities",
    "canonical_entities",
    "aliases",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "identity_version": {
      "const": "entity-identity-v1"
    },
    "platform_tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "source_account_id",
          "asset_type",
          "asset_id",
          "first_observed_at",
          "last_observed_at",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_account_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "asset_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "first_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_sha256",
                "raw_sha256",
                "event_id",
                "observed_at"
              ],
              "properties": {
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "raw_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "canonical_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "entity_type", "basis"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "entity_type": {
            "enum": [
              "person",
              "account",
              "device",
              "resource",
              "repository",
              "service",
              "organization",
              "unknown"
            ]
          },
          "basis": {
            "const": "caller_asserted"
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_entity_id",
          "canonical_entity_id",
          "basis",
          "assertion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_entity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "canonical_entity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "const": "caller_asserted"
          },
          "assertion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_account_id",
              "asset_type",
              "asset_id",
              "evidence_sha256",
              "asserted_by",
              "asserted_at",
              "reason"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_account_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "asset_type": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "asserted_by": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "asserted_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_id", "manifest_sha256"],
          "properties": {
            "generation_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  },
  "title": "entity-registry"
}
