{
  "spec_version": 1,
  "name": "ocsf_data_security_finding",
  "description": "OCSF Data Security Finding (class_uid 2006), OCSF 1.5.0 release tag, source 78bf68a24b38c0d6441ddd13b9028c1b1eb53f07. Source observations only; no safeguard binding or inferred control verdict.",
  "source": {
    "table": "ocsf_table",
    "incremental": true,
    "lookback_minutes": 60
  },
  "filters": [
    {
      "column": "class_uid",
      "op": "eq",
      "value": 2006
    }
  ],
  "fields": {
    "id": {
      "column": "metadata.uid"
    },
    "observed_at": {
      "column": "time",
      "format": "epoch_ms"
    },
    "source": {
      "coalesce": [
        {
          "column": "metadata.product.name"
        },
        {
          "const": "ocsf"
        }
      ]
    },
    "severity": {
      "column": "severity_id",
      "map": {
        "0": "info",
        "1": "info",
        "2": "low",
        "3": "medium",
        "4": "high",
        "5": "critical",
        "6": "critical",
        "99": "info"
      },
      "default": "info"
    },
    "event_type": {
      "const": "ocsf.data_security_finding"
    },
    "asset_id": {
      "column": "finding_info.uid"
    },
    "asset_type": {
      "const": "lake_record"
    },
    "status": {
      "const": "observed"
    },
    "controls": {
      "const": ["SOC2-C1.1", "ISO27001-A.8.12"]
    },
    "source_account_id": {
      "column": "cloud.account.uid"
    },
    "evidence_ref": {
      "column": "finding_info.src_url"
    }
  },
  "attributes": {
    "ocsf_class_uid": {
      "column": "class_uid"
    },
    "ocsf_activity_id": {
      "column": "activity_id"
    },
    "ocsf_version": {
      "column": "metadata.version"
    },
    "ocsf_schema_release": {
      "const": "1.5.0"
    },
    "ocsf_schema_revision": {
      "const": "78bf68a24b38c0d6441ddd13b9028c1b1eb53f07"
    },
    "product": {
      "column": "metadata.product.name"
    },
    "product_version": {
      "column": "metadata.product.version"
    },
    "vendor": {
      "column": "metadata.product.vendor_name"
    },
    "cloud_account": {
      "column": "cloud.account.uid"
    },
    "cloud_region": {
      "column": "cloud.region"
    },
    "source_status_id": {
      "column": "status_id"
    },
    "source_status": {
      "column": "status"
    },
    "finding_info": {
      "column": "finding_info"
    },
    "data_security": {
      "column": "data_security"
    },
    "resources": {
      "column": "resources"
    },
    "database": {
      "column": "database"
    },
    "databucket": {
      "column": "databucket"
    },
    "file": {
      "column": "file"
    },
    "table": {
      "column": "table"
    },
    "device": {
      "column": "device"
    },
    "is_alert": {
      "column": "is_alert"
    }
  }
}
