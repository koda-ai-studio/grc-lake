{
  "spec_version": 1,
  "name": "ocsf_device_inventory",
  "description": "OCSF Device Inventory (class_uid 5001), OCSF 1.5.0 release tag, source 78bf68a24b38c0d6441ddd13b9028c1b1eb53f07. Source observations only; no safeguard binding or inferred control verdict.",
  "source": {
    "table": "ocsf_table",
    "incremental": true,
    "lookback_minutes": 60
  },
  "filters": [
    {
      "column": "class_uid",
      "op": "eq",
      "value": 5001
    }
  ],
  "fields": {
    "id": {
      "column": "metadata.uid"
    },
    "observed_at": {
      "column": "time",
      "format": "epoch_ms"
    },
    "source": {
      "coalesce": [
        {
          "column": "metadata.product.name"
        },
        {
          "const": "ocsf"
        }
      ]
    },
    "severity": {
      "column": "severity_id",
      "map": {
        "0": "info",
        "1": "info",
        "2": "low",
        "3": "medium",
        "4": "high",
        "5": "critical",
        "6": "critical",
        "99": "info"
      },
      "default": "info"
    },
    "event_type": {
      "const": "ocsf.device_inventory"
    },
    "asset_id": {
      "column": "device.uid"
    },
    "asset_type": {
      "const": "host"
    },
    "status": {
      "const": "observed"
    },
    "controls": {
      "const": ["ISO27001-A.5.9", "NIST-800-53-CM-8"]
    },
    "source_account_id": {
      "column": "cloud.account.uid"
    }
  },
  "attributes": {
    "ocsf_class_uid": {
      "column": "class_uid"
    },
    "ocsf_activity_id": {
      "column": "activity_id"
    },
    "ocsf_version": {
      "column": "metadata.version"
    },
    "ocsf_schema_release": {
      "const": "1.5.0"
    },
    "ocsf_schema_revision": {
      "const": "78bf68a24b38c0d6441ddd13b9028c1b1eb53f07"
    },
    "product": {
      "column": "metadata.product.name"
    },
    "product_version": {
      "column": "metadata.product.version"
    },
    "vendor": {
      "column": "metadata.product.vendor_name"
    },
    "cloud_account": {
      "column": "cloud.account.uid"
    },
    "cloud_region": {
      "column": "cloud.region"
    },
    "source_status_id": {
      "column": "status_id"
    },
    "source_status": {
      "column": "status"
    },
    "device": {
      "column": "device"
    }
  }
}
